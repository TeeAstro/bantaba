// Phase 2 — core schema.
// Money is always stored as an integer in minor units (butut) with an
// explicit currency column — never floating point, per the Phase 0 plan.
// Append-only tables (CheckIn, WalletTransaction, AuditLog) are never
// updated or deleted by application code; they exist as a source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  CUSTOMER
  ORGANIZER
  STAFF
  ADMIN
}

enum OrganizerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED // ticket sales for all their events stop (docs/organizer-trust.md)
}

// How far the platform trusts an approved organizer (docs/organizer-trust.md).
// NEW: events reviewed before going live, no bank-transfer confirming,
// cancelling always refunds everyone, ticket/price limits per event.
// TRUSTED: none of those restrictions. Per-organizer overrides on
// Organizer can loosen or tighten either.
enum OrganizerTrustLevel {
  NEW
  TRUSTED
}

// Organizer payouts (docs/payouts.md)
enum PayoutStatus {
  REQUESTED // organizer asked; waiting for an admin
  APPROVED // admin approved; money still to be sent
  PAID // money sent, with a reference
  REJECTED // admin declined, with a reason
  CANCELLED // organizer withdrew the request
}

enum PayoutMethod {
  WAVE
  BANK
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum TicketTypeCategory {
  REGULAR
  VIP
  VVIP
  EARLY_BIRD
  STUDENT
  GROUP
  FAMILY
  GENERAL_ADMISSION
  BACKSTAGE
  MEET_AND_GREET
  SEASON_PASS
  DAY_PASS
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED
  EXPIRED
  TRANSFERRED
}

// Phase 8: state of one seat for one event. There is no AVAILABLE value
// on purpose — a seat with no EventSeat row for an event is available.
// See docs/seating.md.
enum EventSeatStatus {
  HELD // claimed by a PENDING order; released if that order fails or expires
  SOLD // its ticket has been minted
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProviderType {
  WAVE
  BANK_TRANSFER
  PAYPAL
  CARD // Visa/Mastercard debit and credit cards, through Modem Pay's hosted checkout (docs/payments.md)
  MOCK // dev/testing only — PaymentsService refuses this when NODE_ENV=production
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED // customer asked; waiting for the organizer
  APPROVED // decided: tickets are void, money still to be returned
  REJECTED
  PROCESSED // money returned
  WITHDRAWN // customer took the request back
}

// Phase 13 (docs/refunds-transfers.md)
enum RefundPolicy {
  NONE // no refunds on request (cancellations and changes still refund)
  UNTIL_DAYS_BEFORE // until refundDaysBefore days before the start
  ANYTIME // until the event starts
}

enum RefundKind {
  CUSTOMER_REQUEST
  ORGANIZER // organizer/admin refunded directly
  EVENT_CANCELLED
}

enum RefundMethod {
  PROVIDER // returned through the payment provider's API (Wave full refunds, Mock)
  MANUAL // paid back by hand (bank transfers, partial Wave refunds); an admin marks it done
}

enum CancellationRefundMode {
  AUTOMATIC // everyone refunded in full when the event is cancelled
  ORGANIZER // organizer handles it; holders may request a refund at any time
}

enum PromoType {
  PERCENTAGE
  FIXED
}

enum NfcCredentialStatus {
  ACTIVE
  REVOKED
  REPLACED
}

enum CheckInResult {
  VALID
  ALREADY_USED
  INVALID
  CANCELLED
  REFUNDED
  WRONG_EVENT
  WRONG_DATE
  NO_ACCESS
}

enum StaffRole {
  GATE_STAFF
  SCANNER_OPERATOR
  SECURITY
  MANAGER
  CASHIER
  VIP_STAFF
  EVENT_ADMINISTRATOR
}

enum WalletTransactionType {
  TOPUP
  PAYMENT
  REFUND
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED // recipient declined
  CANCELLED // sender took it back, or the ticket stopped being transferable
  EXPIRED
}

enum ResaleStatus {
  LISTED
  SOLD
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  PUSH
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED // no longer needed (e.g. a change that was undone before sending)
}

// ---------- Auth ----------

model RefreshToken {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String        @unique // never store the raw refresh token
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?       @unique
  replacedByToken   RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacesToken     RefreshToken? @relation("TokenRotation")

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // never store the raw reset token
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Identity ----------

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  phone             String?    @unique
  passwordHash      String
  // Phase 18d: when the person chose a password. Null for accounts made by
  // guest checkout or an email code, which have a random one nobody knows.
  passwordSetAt     DateTime?
  role              UserRole   @default(CUSTOMER)
  fullName          String?
  profilePictureUrl String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  // Phase 9: for STAFF accounts, the organizer that created (and employs)
  // them. Staff are scoped to one organizer (docs/architecture.md
  // Section 8): only that organizer can assign them to events.
  staffOrganizerId  String?
  staffOrganizer    Organizer? @relation("OrganizerStaffAccounts", fields: [staffOrganizerId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organizer           Organizer?
  wallet              Wallet?
  orders              TicketOrder[]
  tickets             Ticket[]
  eventStaffRoles     EventStaff[]
  transfersSent       TicketTransfer[]     @relation("TransferFrom")
  transfersReceived   TicketTransfer[]     @relation("TransferTo")
  reviews             Review[]
  favorites           FavoriteEvent[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Organizer {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String

  // Public profile (docs/organizer-profiles.md): /o/<slug> in the web app.
  slug               String                      @unique
  logoUrl            String? // square profile picture / logo, 800×800
  bannerUrl          String? // 3:1 cover, 1920×640
  bio                String? // "About", up to 1,000 characters
  location           String? // e.g. "Serrekunda"
  website            String?
  contactEmail       String?
  contactPhone       String?
  socialLinks        Json? // { facebook, instagram, tiktok, x, youtube, whatsapp }: full https URLs on each platform's own domain
  profileUpdatedAt   DateTime?
  verificationStatus OrganizerVerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  // Anti-fraud permissions (docs/organizer-trust.md). An override of null
  // means "use the trust level's default".
  trustLevel                   OrganizerTrustLevel @default(NEW)
  requireEventReview           Boolean?
  canConfirmBankTransfers      Boolean?
  canHandleCancellationRefunds Boolean?
  customLimits                 Boolean             @default(false) // use the two limits below instead of the level's
  maxTicketsPerEvent           Int? // with customLimits: null = no limit
  maxTicketPrice               Int? // minor units; with customLimits: null = no limit
  trustNote                    String? // admin's private note
  trustUpdatedAt               DateTime?

  // Verified badge (blue tick): the platform has confirmed this is the
  // official account of who it says it is (e.g. a federation or a known
  // venue). Shown publicly only while the account is APPROVED.
  verifiedBadge   Boolean   @default(false)
  verifiedBadgeAt DateTime?

  // Payouts (docs/payouts.md). Where the organizer's money is sent; any
  // change clears payoutDetailsVerifiedAt until an admin checks it again.
  payoutMethod              PayoutMethod?
  payoutAccountName         String?
  payoutAccountNumber       String? // Wave: phone number; bank: account number
  payoutBankName            String?
  payoutDetailsUpdatedAt    DateTime?
  payoutDetailsVerifiedAt   DateTime?
  payoutDetailsVerifiedById String?
  // Share (0-100) of an upcoming event's earnings that may be paid out
  // before it has taken place. 0 = only after the event.
  payoutAdvancePercent      Int           @default(0)
  // Payouts this organizer asks for are approved automatically (an admin
  // still sends the money). Up to payoutAutoApproveMax each when set.
  payoutAutoApprove         Boolean       @default(false)
  payoutAutoApproveMax      Int? // minor units; null = no limit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        Event[]
  staff         EventStaff[]
  staffAccounts User[]       @relation("OrganizerStaffAccounts")
  payouts       Payout[]

  // Phase 18: venues they made, Bantaba venues shared with them, templates
  venues         Venue[]         @relation("VenueOwner")
  venueShares    VenueShare[]
  eventTemplates EventTemplate[]

  @@map("organizers")
}

// ---------- Venues ----------

model Venue {
  id         String     @id @default(uuid())
  name       String
  address    String
  city       String
  country    String     @default("The Gambia")
  // What the seats face, shown above every seat grid: "Stage", "Pitch"…
  frontLabel String     @default("Stage")
  // Phase 18 (docs/seating.md, "Who manages venues"): the organizer who
  // made it, only they (and admins) can use and change it. Null = Bantaba's,
  // made by admins: "everyone" = any organizer can sell on it, "chosen" =
  // only the organizers in `shares`. Organizers never change its layout.
  ownerId    String?
  owner      Organizer? @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  sharing    String     @default("everyone")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  shares      VenueShare[]
  templates   EventTemplate[]
  map         VenueMap?
  sections    VenueSection[]
  gates       Gate[]
  accessZones AccessZone[]
  events      Event[]

  @@index([ownerId])
  @@map("venues")
}

// A Bantaba venue shared with one organizer (Venue.sharing = "chosen").
model VenueShare {
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([venueId, organizerId])
  @@index([organizerId])
  @@map("venue_shares")
}

// Phase 18: an event saved to start new ones from (docs/templates.md):
// details, ticket types and seating, never dates, sales or buyers.
model EventTemplate {
  id          String    @id @default(uuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name        String
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  // { event: {…details}, durationMinutes, ticketTypes: [{ key, … }], sections: [{ sectionId, ticketTypeKey }], closedSeatIds }
  data        Json
  timesUsed   Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizerId])
  @@map("event_templates")
}

// The venue's drawing (Phase 17, docs/seating.md): an SVG an admin drew in
// Figma, Inkscape… with every section's shape in a group called
// "sections". Stored already cleaned (no scripts, links or outside
// files), with each section shape tagged data-bt-section="<mapKey>".
model VenueMap {
  venueId      String   @id
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  svg          String   @db.Text
  fileName     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())
  uploadedById String?

  @@map("venue_maps")
}

model VenueSection {
  id        String  @id @default(uuid())
  venueId   String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  isVip     Boolean @default(false)
  // The section's shape in the venue drawing: its name, lower-cased.
  // Re-uploading a drawing matches sections by this. Null = not drawn.
  mapKey    String?
  // The gate its ticket holders go in by ("Gate 5" for 5A, 5B, 5C).
  gateId    String?
  gate      Gate?   @relation(fields: [gateId], references: [id], onDelete: SetNull)
  // How its seats are numbered: "letters" = each row from 1 (A1–A30,
  // B1–B20); "running" = on through the section (A1–A30, B31–B50);
  // "seats" = one number per seat, no row letters (1–144; rows stored as
  // "#1", "#2"…).
  numbering String  @default("letters")

  seats         Seat[]
  eventSections EventSection[]

  @@unique([venueId, mapKey])
  @@index([venueId])
  @@map("venue_sections")
}

// Which ticket type a section is sold as, per event (Phase 17). A ticket
// type with at least one section is reserved seating; its quantityTotal is
// kept equal to the open seats in its sections. No row = not on sale.
model EventSection {
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectionId    String
  section      VenueSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@id([eventId, sectionId])
  @@index([ticketTypeId])
  @@index([sectionId])
  @@map("event_sections")
}

// A seat the organizer took off sale for one event (camera, stage, sound
// desk). Venue-wide blocks are Seat.isBlocked instead.
model ClosedSeat {
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([eventId, seatId])
  @@index([seatId])
  @@map("closed_seats")
}

model Seat {
  id        String       @id @default(uuid())
  sectionId String
  section   VenueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  row       String
  number    String
  // Where it sits in its row, from 1, counting places taken out (aisles).
  // Null for seats made before Phase 17: their number is their place.
  place     Int?
  isBlocked Boolean      @default(false) // venue-wide: never sellable for any event (broken seat, camera position…)

  tickets     Ticket[]
  eventSeats  EventSeat[]
  closedSeats ClosedSeat[]

  @@unique([sectionId, row, number])
  @@map("seats")
}

model Gate {
  id           String      @id @default(uuid())
  venueId      String
  venue        Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name         String
  // Phase 8: the zone this gate admits into. A ticket whose zone level is
  // below this zone's level gets NO_ACCESS here. Null = open gate, any
  // ticket for the venue may enter. See docs/seating.md.
  accessZoneId String?
  accessZone   AccessZone? @relation(fields: [accessZoneId], references: [id], onDelete: SetNull)

  checkIns     CheckIn[]
  staffDefault EventStaff[]
  sections     VenueSection[]

  @@index([venueId])
  @@map("gates")
}

model AccessZone {
  id      String @id @default(uuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String // e.g. "Main", "VIP", "VVIP", "Backstage"
  level   Int    @default(0) // higher = more access; used for zone-inclusion checks

  ticketTypes TicketType[]
  gates       Gate[]

  @@index([venueId])
  @@map("access_zones")
}

// ---------- Events ----------

model EventCategory {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  events Event[]

  @@map("event_categories")
}

model Event {
  id          String        @id @default(uuid())
  organizerId String
  organizer   Organizer     @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  categoryId  String
  category    EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  venueId     String
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)

  name           String
  slug           String      @unique
  description    String?
  posterUrl      String?
  bannerUrl      String?
  startDate      DateTime
  endDate        DateTime
  ageRestriction Int?
  rules          String?
  contactEmail   String?
  contactPhone   String?
  socialLinks    Json?
  status         EventStatus @default(DRAFT)

  // Phase 13: refunds and transfers (docs/refunds-transfers.md)
  refundPolicy           RefundPolicy            @default(NONE)
  refundDaysBefore       Int? // with UNTIL_DAYS_BEFORE
  transfersEnabled       Boolean                 @default(true)
  scheduleChangedAt      DateTime? // last date/venue change while live; earlier buyers may then always ask for a refund
  cancelledAt            DateTime?
  cancellationRefundMode CancellationRefundMode?

  // Review before going live, for organizers who need it (docs/organizer-trust.md)
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewNote           String? // shown to the organizer when sent back

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes    TicketType[]
  orders         TicketOrder[]
  promoCodes     PromoCode[]
  eventStaff     EventStaff[]
  reviews        Review[]
  favorites      FavoriteEvent[]
  eventSeats     EventSeat[]
  eventSections  EventSection[]
  closedSeats    ClosedSeat[]
  checkIns       CheckIn[]
  changeRequests EventChangeRequest[]
  trendingPick   TrendingPick?
  trendingHidden TrendingHidden?

  @@index([organizerId])
  @@index([categoryId])
  @@index([venueId])
  @@index([status])
  @@map("events")
}

enum EventChangeStatus {
  PENDING // waiting for an admin; the event keeps its approved details meanwhile
  APPROVED // applied to the event
  REJECTED // not applied; decisionNote tells the organizer why
  WITHDRAWN // the organizer took it back, or the event was cancelled
}

// Edits to an approved, on-sale event by an organizer whose events need
// review (docs/event-change-review.md). Held here, not on the event, so
// buyers never see unreviewed details. At most one PENDING per event;
// later edits are merged into it.
model EventChangeRequest {
  id      String            @id @default(uuid())
  eventId String
  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status  EventChangeStatus @default(PENDING)
  // Proposed values, only for fields that differ from the event:
  // name, description, startDate, endDate, venueId, posterUrl, bannerUrl.
  changes Json

  submittedById String
  submittedAt   DateTime  @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([status])
  @@map("event_change_requests")
}

// ---------- Ticketing ----------

model TicketType {
  id            String             @id @default(uuid())
  eventId       String
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  category      TicketTypeCategory @default(REGULAR)
  price         Int // minor units (butut)
  currency      String             @default("GMD")
  quantityTotal Int
  quantitySold  Int                @default(0)
  accessZoneId  String?
  accessZone    AccessZone?        @relation(fields: [accessZoneId], references: [id], onDelete: SetNull)
  salesStart    DateTime?
  salesEnd      DateTime?
  isActive      Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets       Ticket[]
  orderItems    OrderItem[]
  eventSeats    EventSeat[]
  // Phase 17: the sections sold as this ticket type. Any = reserved
  // seating (buyers pick seats); none = general admission.
  eventSections EventSection[]

  @@index([eventId])
  @@map("ticket_types")
}

model Ticket {
  id           String       @id @default(uuid())
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  orderId      String?
  order        TicketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  seatId       String?
  seat         Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)

  qrCredentialHash String       @unique // hash of the random token encoded in the QR — never the raw ticket ID
  qrCodeSvg        String?      @db.Text // rendered QR image (SVG markup), generated once at mint time while the raw token is still in memory — see docs/checkin.md. The raw token itself is never stored here or anywhere else.
  status           TicketStatus @default(ACTIVE)
  purchasedAt      DateTime     @default(now())
  expiresAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nfcCredential NfcCredential?
  checkIns      CheckIn[]
  transfers     TicketTransfer[]
  resale        TicketResale?
  eventSeat     EventSeat?
  refundItems   RefundItem[]

  @@index([ticketTypeId])
  @@index([ownerId])
  @@index([orderId])
  @@index([status])
  @@map("tickets")
}

model TicketOrder {
  id          String     @id @default(uuid())
  customerId  String
  customer    User       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  subtotal       Int
  discount       Int         @default(0)
  platformFee    Int         @default(0)
  paymentFee     Int         @default(0)
  total          Int
  currency       String      @default("GMD")
  status         OrderStatus @default(PENDING)
  expiresAt      DateTime? // while PENDING: when the inventory hold lapses if never paid
  // Phase 16: a guest checkout's private key to this one order (pay it,
  // see its tickets) without signing in. Only the hash is stored.
  guestTokenHash String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      OrderItem[]
  tickets    Ticket[]
  payments   Payment[]
  eventSeats EventSeat[]
  refunds    Refund[]

  @@index([customerId])
  @@index([eventId])
  @@index([status])
  @@map("ticket_orders")
}

model OrderItem {
  id           String      @id @default(uuid())
  orderId      String
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Int // minor units, snapshot of price at purchase time

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_items")
}

// Phase 8: one row per seat that is held or sold for one event. The
// @@unique([eventId, seatId]) constraint is what makes double-selling a
// seat impossible: two concurrent checkouts both INSERT the same pair,
// and Postgres lets exactly one of them win. Released holds are DELETEd,
// not flipped to some AVAILABLE status. See docs/seating.md.
model EventSeat {
  id           String          @id @default(uuid())
  eventId      String
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatId       String
  seat         Seat            @relation(fields: [seatId], references: [id], onDelete: Restrict)
  ticketTypeId String // the seated ticket type this seat was bought as (decides the price)
  ticketType   TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  status       EventSeatStatus
  orderId      String
  order        TicketOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketId     String?         @unique // set when status becomes SOLD
  ticket       Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, seatId])
  @@index([orderId])
  @@map("event_seats")
}

// ---------- Payments ----------

model Payment {
  id                String              @id @default(uuid())
  orderId           String
  order             TicketOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProviderType
  providerReference String?             @unique // Wave session id / bank ref / PayPal order id
  amount            Int
  currency          String              @default("GMD")
  status            PaymentStatus       @default(PENDING)
  rawPayload        Json? // last known verified payload from the provider, for audit/debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// One refund = some tickets of one order, paid back through one payment.
// amount = ticket share (items) + feeAmount (booking fee, only returned
// when the event is cancelled). See docs/refunds-transfers.md.
model Refund {
  id            String       @id @default(uuid())
  paymentId     String
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId       String
  order         TicketOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind          RefundKind   @default(ORGANIZER)
  method        RefundMethod @default(MANUAL)
  amount        Int // total to return, minor units
  feeAmount     Int          @default(0) // part of amount that is booking fee
  reason        String?
  status        RefundStatus @default(REQUESTED)
  requestedById String?
  approvedById  String? // whoever decided (approved or rejected)
  decidedAt     DateTime?
  decisionNote  String?
  processedAt   DateTime?
  reference     String? // provider refund id, or the bank/Wave reference of a manual payout
  attempts      Int          @default(0) // provider refund attempts
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RefundItem[]

  @@index([paymentId])
  @@index([orderId])
  @@index([status, method])
  @@map("refunds")
}

// Money paid out to an organizer (docs/payouts.md). Every payout is asked
// for by the organizer and approved by an admin; the account it goes to is
// copied in at request time.
model Payout {
  id            String       @id @default(uuid())
  organizerId   String
  organizer     Organizer    @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  amount        Int // minor units
  currency      String       @default("GMD")
  status        PayoutStatus @default(REQUESTED)
  method        PayoutMethod
  accountName   String
  accountNumber String
  bankName      String?
  note          String? // from the organizer
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  autoApproved  Boolean      @default(false) // approved by the organizer's auto-approval setting, not by an admin
  decisionNote  String? // reason when rejected
  paidAt        DateTime?
  paidById      String?
  reference     String? // Wave / bank transfer reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId, status])
  @@index([status])
  @@map("payouts")
}

model RefundItem {
  id           String @id @default(uuid())
  refundId     String
  refund       Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  ticketId     String
  ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  ticketTypeId String
  amount       Int // this ticket's share, after any discount

  @@unique([refundId, ticketId])
  @@index([ticketId])
  @@map("refund_items")
}

model PromoCode {
  id          String    @id @default(uuid())
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code        String    @unique
  type        PromoType
  value       Int // percentage points, or minor-unit amount, depending on `type`
  usageLimit  Int?
  usageCount  Int       @default(0)
  minPurchase Int?
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders TicketOrder[]

  @@index([eventId])
  @@map("promo_codes")
}

// ---------- NFC ----------

model NfcCredential {
  id              String              @id @default(uuid())
  ticketId        String              @unique
  ticket          Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  secureTokenHash String              @unique // hash of the secure token — never the raw chip UID
  status          NfcCredentialStatus @default(ACTIVE)
  issuedAt        DateTime            @default(now())
  revokedAt       DateTime?

  @@map("nfc_credentials")
}

// ---------- Access control / check-in ----------

model CheckIn {
  id        String        @id @default(uuid())
  // Phase 10: the event being worked at the door when this scan happened.
  // Usually the ticket's own event; differs on WRONG_EVENT, which must
  // show up in the scanning event's log, not the other event's.
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  gateId    String?
  gate      Gate?         @relation(fields: [gateId], references: [id], onDelete: SetNull)
  staffId   String?
  result    CheckInResult
  scannedAt DateTime      @default(now())

  // Append-only: application code must never UPDATE or DELETE rows here.
  @@index([eventId])
  @@index([ticketId])
  @@index([scannedAt])
  @@map("check_ins")
}

model EventStaff {
  id             String    @id @default(uuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizerId    String
  organizer      Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  role           StaffRole
  assignedGateId String?
  assignedGate   Gate?     @relation(fields: [assignedGateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  devices StaffDevice[]

  @@unique([eventId, userId])
  @@index([organizerId])
  @@map("event_staff")
}

model StaffDevice {
  id               String     @id @default(uuid())
  staffId          String
  staff            EventStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  deviceIdentifier String
  registeredAt     DateTime   @default(now())
  lastSeenAt       DateTime?

  @@unique([staffId, deviceIdentifier])
  @@map("staff_devices")
}

// ---------- Wallet (Phase 17 groundwork — tables exist now, not used yet) ----------

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance  Int    @default(0)
  currency String @default("GMD")

  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String                @id @default(uuid())
  walletId     String
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type         WalletTransactionType
  amount       Int // positive for top-up/refund, negative for payment
  balanceAfter Int
  referenceId  String?

  createdAt DateTime @default(now())

  // Append-only ledger: never mutate a balance without a row here.
  @@index([walletId])
  @@map("wallet_transactions")
}

// ---------- Transfers & resale ----------

// Phase 13: a ticket offered to someone by email. They accept with the
// link (signing in or creating an account with that email); the ticket
// then gets a new QR code and the old one stops working.
model TicketTransfer {
  id         String         @id @default(uuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User           @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toEmail    String // lower-cased
  toUserId   String? // set when accepted
  toUser     User?          @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Restrict)
  status     TransferStatus @default(PENDING)
  tokenHash  String         @unique // hash of the token in the emailed link
  expiresAt  DateTime

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([ticketId, status])
  @@index([fromUserId])
  @@index([toEmail, status])
  @@map("ticket_transfers")
}

model TicketResale {
  id       String       @id @default(uuid())
  ticketId String       @unique
  ticket   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sellerId String
  price    Int
  status   ResaleStatus @default(LISTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_resales")
}

// ---------- Engagement ----------

// Phase 12: the notification outbox. A row is written in the same
// transaction as whatever caused it (an order being paid, an event being
// changed...), and a background worker sends it — see docs/notifications.md.
// The message itself is rendered at send time from current data, so the
// table holds no copies of tickets or personal details beyond what's
// needed to describe a change.
model Notification {
  id      String              @id @default(uuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  type    String // order_confirmed, event_changed, event_reminder... (notifications/types.ts)
  payload Json?
  status  NotificationStatus  @default(PENDING)
  sentAt  DateTime?

  // Same key twice = same message: makes enqueueing idempotent (a retried
  // webhook can't send two confirmations).
  dedupeKey   String?   @unique
  eventId     String? // for finding/cancelling an event's pending messages
  orderId     String?
  sendAfter   DateTime  @default(now()) // not before this (delays, retry backoff)
  attempts    Int       @default(0)
  lockedUntil DateTime? // claimed by a worker until then
  lastError   String?
  toAddress   String? // where it was actually sent
  subject     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, sendAfter])
  @@index([eventId, type, status])
  @@map("notifications")
}

model Review {
  id         String  @id @default(uuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  isVerified Boolean @default(false) // true only for confirmed attendees (checked-in ticket holders)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("reviews")
}

model FavoriteEvent {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@map("favorite_events")
}

// ---------- Audit ----------

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  // Append-only: never updated or deleted by application code.
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------- Phase 16: storefront (docs/storefront.md) ----------

// Trending, the first row on the Bantaba home page: admin picks first,
// then the best sellers of the last 7 days.
model TrendingPick {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position    Int // 1 = first
  until       DateTime // shown until then (at the latest until the event ends)
  createdById String?
  createdAt   DateTime @default(now())

  @@map("trending_picks")
}

// Events an admin took out of Trending's automatic part.
model TrendingHidden {
  eventId    String   @id
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hiddenById String?
  hiddenAt   DateTime @default(now())

  @@map("trending_hidden")
}

// Small platform-wide settings an admin can change, by key, e.g.
// "trending" = { "count": 6, "onePerHost": true }.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// Buyers sign in with a 6-digit code sent to their email (no password
// needed). Only the hash is stored; 10 minutes, 5 tries.
model EmailLoginCode {
  id        String    @id @default(uuid())
  email     String // lower case
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@map("email_login_codes")
}

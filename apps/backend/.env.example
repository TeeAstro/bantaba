# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (matches docker-compose.yml's postgres service — host port 5433,
# not the default 5432, to avoid clashing with any Postgres already running
# on your machine)
DATABASE_URL="postgresql://ticketing:ticketing_dev_password@localhost:5433/ticketing_dev?schema=public"
# Database connections per server (default 10; docs/load-test.md).
# DB_POOL_SIZE=10

# Redis: sign-in and checkout limits shared by every API server (Phase 22,
# docs/deploy.md). Without it the limits are kept in this process only,
# which is fine for one server and for development.
# REDIS_URL="redis://localhost:6379"

# Auth — generate a real random secret for anything beyond local dev, e.g.:
#   openssl rand -hex 32
# Never commit a real value here.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
# Note: refresh tokens are opaque random values stored hashed in the
# database (see docs/auth.md), not JWTs — there's no separate secret for
# them to configure.

# Ticketing (Phase 5) — flat platform fee applied once per order, in
# minor units (butut). D50.00 default. Since Phase 20 this is only the
# fallback: once an admin saves a fee on Admin → Fees, that is used
# (docs/payments.md, "Booking fee").
TICKET_PLATFORM_FEE_MINOR_UNITS=5000

# Payments (Phase 6)
# How long a PENDING order holds its inventory reservation before it's
# eligible for release. See docs/payments.md.
# Phase 16: 5 minutes to choose how to pay; starting a payment extends it
# (PAYMENT_WINDOW_MINUTES for Wave and card, BANK_TRANSFER_HOLD_HOURS for a
# bank transfer). See docs/storefront.md.
RESERVATION_TTL_MINUTES=5
# PAYMENT_WINDOW_MINUTES=15
# BANK_TRANSFER_HOLD_HOURS=24
# MAX_TICKETS_PER_ORDER=10

# Storefront (Phase 16, docs/storefront.md)
# How often Trending's sales counts are worked out, in seconds.
# TRENDING_CACHE_SECONDS=3600
# Limits on sign-in, sign-up, password checks, checkout and email codes;
# "off" only for tests (a production server refuses to start with it).
# RATE_LIMITS=off

# Security review (Phase 21b, docs/security.md)
# Test payments (provider "MOCK": tickets without paying). Only for local
# testing; never in production (the server refuses to start with it).
ALLOW_MOCK_PAYMENTS=true
# Behind a load balancer or proxy: how many sit in front of the server, so
# limits see each buyer's own address. 0 (default) = reached directly.
# TRUST_PROXY=1
# Unpaid orders with a payment started one account may have per event.
# MAX_OPEN_PAYMENTS_PER_EVENT=2

# Wave Business API — leave unset until a real Wave Business account
# exists. WaveProvider fails clearly (not silently) when these are
# missing. See docs/payments.md.
# WAVE_API_KEY=
# WAVE_WEBHOOK_SECRET=
# WAVE_API_BASE_URL=https://api.wave.com/v1
# WAVE_SUCCESS_URL=http://localhost:3000/checkout/success   (?order=<id> is added)
# WAVE_ERROR_URL=http://localhost:3000/checkout/error

# Bank transfer — shown to customers as payment instructions.
BANK_NAME="Sample Bank Gambia"
BANK_ACCOUNT_NAME="Event Ticketing Platform Ltd"
BANK_ACCOUNT_NUMBER="0000000000"

# QR / Check-in (Phase 7) — how many minutes before an event's listed
# start time a ticket can be scanned in (doors-open window). Default 180
# = 3 hours. See docs/checkin.md.
CHECKIN_WINDOW_BEFORE_MINUTES=180

# Mobile apps (organizer/staff app) — GET /api/v1/app-config. Versions
# are x.y.z. An app below the minimum blocks and asks the user to update;
# below "latest" it may suggest updating. Raise the minimum and restart
# to force an update — no code change needed. See docs/api.md.
MOBILE_MIN_VERSION_IOS=0.0.0
MOBILE_MIN_VERSION_ANDROID=0.0.0
MOBILE_LATEST_VERSION_IOS=0.0.0
MOBILE_LATEST_VERSION_ANDROID=0.0.0

# File storage (event banners and posters) — live setup in docs/deploy.md.
# Default: files on this server's disk under apps/backend/uploads,
# served at http://localhost:4000/media. To view images from a phone on
# your network, set MEDIA_PUBLIC_URL=http://<your-mac-ip>:4000/media
# before uploading.
# STORAGE_DRIVER=local
# MEDIA_PUBLIC_URL=http://localhost:4000/media
# MEDIA_DIR=./uploads
#
# Production: any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# STORAGE_DRIVER=s3
# S3_BUCKET=etp-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# MEDIA_PUBLIC_URL=https://media.example.com

# Server-Timing response header (docs/api.md): on outside production;
# set to 1 to enable it in production, 0 to turn it off.
# SERVER_TIMING=1

# Notifications (Phase 12) — see docs/notifications.md.
# Without SMTP_HOST, emails aren't sent: each is written as an .html file
# under apps/backend/mail-previews (MAIL_TRANSPORT=log). For a local inbox
# run `docker compose up -d mailpit` and set SMTP_HOST=localhost,
# SMTP_PORT=1025; emails then appear at http://localhost:8025.
# MAIL_TRANSPORT=log
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Bantaba <tickets@localhost>"
APP_NAME="Bantaba"
# Links in emails (reset password, scanner) point here.
# FRONTEND_URL is set above.
# EVENT_CHANGE_NOTIFY_DELAY_MINUTES=5
# REMINDER_HOURS_BEFORE=24
# REMINDER_SCAN_MINUTES=10
# NOTIFY_POLL_SECONDS=5
# RESERVATION_SWEEP_SECONDS=60
# NOTIFICATIONS_WORKER=on

# Organizer trust levels (anti-fraud) — see docs/organizer-trust.md.
# Limits for NEW organizers (TRUSTED have none). Admins can set custom
# limits per organizer. Price is in minor units (250000 = D2,500.00).
# NEW_ORGANIZER_MAX_TICKETS_PER_EVENT=300
# NEW_ORGANIZER_MAX_TICKET_PRICE=250000

# Organizer payouts — see docs/payouts.md.
# Days after an event ends before its money can be paid out.
# PAYOUT_HOLD_DAYS=2
# Smallest payout in minor units (10000 = D100), unless it empties the balance.
# PAYOUT_MIN_AMOUNT=10000

# Card payments (Visa/Mastercard) through Modem Pay — see docs/payments.md.
# A production server refuses test keys unless MODEMPAY_TEST_MODE=true
# (for the site before launch; docs/deploy.md).
# MODEMPAY_TEST_MODE=true
# Without these, card checkout answers 503 "not configured".
# MODEMPAY_SECRET_KEY=sk_test_...
# MODEMPAY_WEBHOOK_SECRET=
# MODEMPAY_AMOUNT_UNIT=major   # dalasis; "minor" = butut. Confirm with Modem Pay.
# Mobile money (Wave, Afrimoney, QMoney) goes to Modem Pay's "wallet"
# choice; name one wallet per method if Modem Pay can open it directly
# (docs/payments.md, "Ways to pay"):
# MODEMPAY_WALLET_METHODS=wallet
# MODEMPAY_METHODS_WAVE=wave
# CARD_RETURN_URL=http://localhost:3000/checkout/success
# CARD_CANCEL_URL=http://localhost:3000/checkout/error

# Phase 24 (docs/series.md): free tickets per person per event, and how
# often a series that keeps going is topped up to its next 8 sessions.
# FREE_TICKETS_PER_PERSON=4
# SERIES_TOPUP_MINUTES=60

# Phase 25 (docs/support.md): how people reach Bantaba, shown on the Help pages.
# SUPPORT_WHATSAPP="+220 300 0000"
# SUPPORT_EMAIL="support@bantaba.gm"
# SUPPORT_HOURS="Mon–Sat, 9:00–18:00"
